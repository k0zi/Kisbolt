<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice;assembly=KD.Avalonia.Rice"
             xmlns:vm="using:Kisbolt.App.ViewModels"
             xmlns:views="using:Kisbolt.App.Views"
             x:Class="Kisbolt.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <rice:RiceStyles />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:StoreViewModel">
      <views:StoreView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
